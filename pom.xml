        <dependency>
            <groupId>com.jetbrains</groupId>
            <artifactId>intellij.platform.editor</artifactId>
            <version>1.0</version>
            <scope>system</scope>
            <systemPath>${ide.home}/lib/intellij.platform.editor.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>com.jetbrains</groupId>
            <artifactId>intellij.platform.editor.ui</artifactId>
            <version>1.0</version>
            <scope>system</scope>
            <systemPath>${ide.home}/lib/intellij.platform.editor.ui.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>com.jetbrains</groupId>
            <artifactId>intellij.platform.icons.impl.intellij</artifactId>
            <version>1.0</version>
            <scope>system</scope>
            <systemPath>${ide.home}/lib/intellij.platform.icons.impl.intellij.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>com.jetbrains</groupId>
            <artifactId>intellij.platform.backend</artifactId>
            <version>1.0</version>
            <scope>system</scope>
            <systemPath>${ide.home}/lib/intellij.platform.backend.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>com.jetbrains</groupId>
            <artifactId>intellij.platform.lang.core</artifactId>
            <version>1.0</version>
            <scope>system</scope>
            <systemPath>${ide.home}/lib/intellij.platform.lang.core.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>com.jetbrains</groupId>
            <artifactId>intellij.platform.analysis</artifactId>
            <version>1.0</version>
            <scope>system</scope>
            <systemPath>${ide.home}/lib/intellij.platform.analysis.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>com.jetbrains</groupId>
            <artifactId>intellij.platform.ide.ui.inspector</artifactId>
            <version>1.0</version>
            <scope>system</scope>
            <systemPath>${ide.home}/lib/intellij.platform.ide.ui.inspector.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>com.jetbrains</groupId>
            <artifactId>intellij.platform.boot</artifactId>
            <version>1.0</version>
            <scope>system</scope>
            <systemPath>${ide.home}/lib/intellij.platform.bootstrap.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>com.jetbrains</groupId>
            <artifactId>intellij.platform.diagnostic.telemetry</artifactId>
            <version>1.0</version>
            <scope>system</scope>
            <systemPath>${ide.home}/lib/intellij.platform.diagnostic.telemetry.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>com.jetbrains</groupId>
            <artifactId>intellij.platform.kernel</artifactId>
            <version>1.0</version>
            <scope>system</scope>
            <systemPath>${ide.home}/lib/intellij.platform.kernel.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>com.jetbrains</groupId>
            <artifactId>intellij.platform.kernel.backend</artifactId>
            <version>1.0</version>
            <scope>system</scope>
            <systemPath>${ide.home}/lib/intellij.platform.kernel.backend.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>com.jetbrains</groupId>
            <artifactId>intellij.libraries.guava</artifactId>
            <version>1.0</version>
