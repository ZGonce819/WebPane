        <dependency>
            <groupId>com.jetbrains</groupId>
            <artifactId>intellij.libraries.grpc</artifactId>
            <version>1.0</version>
            <scope>system</scope>
            <systemPath>${ide.home}/lib/intellij.libraries.grpc.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>com.jetbrains</groupId>
            <artifactId>annotations</artifactId>
            <version>1.0</version>
            <scope>system</scope>
            <systemPath>${ide.home}/lib/annotations.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>com.jetbrains</groupId>
            <artifactId>trove</artifactId>
            <version>1.0</version>
            <scope>system</scope>
            <systemPath>${ide.home}/lib/trove.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>com.jetbrains</groupId>
            <artifactId>intellij.libraries.kotlin.stdlib</artifactId>
            <version>1.0</version>
            <scope>system</scope>
            <systemPath>${ide.home}/lib/intellij.libraries.kotlin.reflect.jar</systemPath>
        </dependency>

        <!-- JCEF Plugin - actual classes are in modules/ subdirectory -->
        <dependency>
            <groupId>com.jetbrains</groupId>
            <artifactId>intellij.platform.ui.jcef</artifactId>
            <version>1.0</version>
            <scope>system</scope>
            <systemPath>${ide.home}/plugins/jcef-plugin/lib/modules/intellij.platform.ui.jcef.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>com.jetbrains</groupId>
            <artifactId>intellij.libraries.jcef</artifactId>
            <version>1.0</version>
            <scope>system</scope>
            <systemPath>${ide.home}/plugins/jcef-plugin/lib/modules/intellij.libraries.jcef.jar</systemPath>
        </dependency>

        <!-- Language platform (LineMarkerInfo etc.) -->
        <dependency>
            <groupId>com.jetbrains</groupId>
            <artifactId>intellij.platform.lang</artifactId>
            <version>1.0</version>
            <scope>system</scope>
            <systemPath>${ide.home}/lib/intellij.platform.lang.jar</systemPath>
        </dependency>

        <!-- XML PSI (XmlTag, XmlFile, XmlDocument) -->
        <dependency>
            <groupId>com.jetbrains</groupId>
            <artifactId>intellij.xml.psi</artifactId>
            <version>1.0</version>
            <scope>system</scope>
            <systemPath>${ide.home}/lib/intellij.xml.psi.jar</systemPath>
        </dependency>

        <!-- Core UI (DataKey, BusyObject) -->
        <dependency>
            <groupId>com.jetbrains</groupId>
            <artifactId>intellij.platform.core.ui</artifactId>
            <version>1.0</version>
            <scope>system</scope>
            <systemPath>${ide.home}/lib/intellij.platform.core.ui.jar</systemPath>
        </dependency>

        <!-- Kotlin Coroutines (StateFlow for annotation processing) -->
        <dependency>
            <groupId>com.jetbrains</groupId>
            <artifactId>intellij.libraries.kotlinx.coroutines.core</artifactId>
            <version>1.0</version>
            <scope>system</scope>
            <systemPath>${ide.home}/lib/intellij.libraries.kotlinx.coroutines.core.jar</systemPath>
        </dependency>

        <!-- Editor UI (GutterIconRenderer) -->
        <dependency>
            <groupId>com.jetbrains</groupId>
            <artifactId>intellij.platform.editor.ui</artifactId>
            <version>1.0</version>
            <scope>system</scope>
            <systemPath>${ide.home}/lib/intellij.platform.editor.ui.jar</systemPath>
        </dependency>
    </dependencies>

    <build>
        <finalName>webpane-${project.version}</finalName>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <release>21</release>
                    <encoding>UTF-8</encoding>
                </configuration>
            </plugin>

            <!-- Package as JAR with resources -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.4.1</version>
                <configuration>
                    <archive>
                        <manifestEntries>
                            <Manifest-Version>1.0</Manifest-Version>
                        </manifestEntries>
                    </archive>
                </configuration>
            </plugin>

            <!-- Assemble plugin ZIP -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-assembly-plugin</artifactId>
                <version>3.7.1</version>
                <configuration>
                    <descriptors>
                        <descriptor>src/assembly/plugin-assembly.xml</descriptor>
                    </descriptors>
                    <finalName>webpane-${project.version}</finalName>
                    <appendAssemblyId>false</appendAssemblyId>
                </configuration>
                <executions>
                    <execution>
                        <id>make-plugin-zip</id>
                        <phase>package</phase>
                        <goals>
                            <goal>single</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
