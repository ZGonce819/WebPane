        <dependency>
            <groupId>com.jetbrains</groupId>
            <artifactId>intellij.platform.util.ex</artifactId>
            <version>1.0</version>
            <scope>system</scope>
            <systemPath>${ide.home}/lib/intellij.platform.util.ex.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>com.jetbrains</groupId>
            <artifactId>intellij.platform.util.coroutines</artifactId>
            <version>1.0</version>
            <scope>system</scope>
            <systemPath>${ide.home}/lib/intellij.platform.util.coroutines.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>com.jetbrains</groupId>
            <artifactId>intellij.platform.core</artifactId>
            <version>1.0</version>
            <scope>system</scope>
            <systemPath>${ide.home}/lib/intellij.platform.core.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>com.jetbrains</groupId>
            <artifactId>intellij.platform.core.impl</artifactId>
            <version>1.0</version>
            <scope>system</scope>
            <systemPath>${ide.home}/lib/intellij.platform.core.impl.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>com.jetbrains</groupId>
            <artifactId>intellij.platform.ide</artifactId>
            <version>1.0</version>
            <scope>system</scope>
            <systemPath>${ide.home}/lib/intellij.platform.ide.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>com.jetbrains</groupId>
            <artifactId>intellij.platform.ide.impl</artifactId>
            <version>1.0</version>
            <scope>system</scope>
            <systemPath>${ide.home}/lib/intellij.platform.ide.impl.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>com.jetbrains</groupId>
            <artifactId>intellij.platform.ide.core</artifactId>
            <version>1.0</version>
            <scope>system</scope>
            <systemPath>${ide.home}/lib/intellij.platform.ide.core.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>com.jetbrains</groupId>
            <artifactId>intellij.platform.projectModel</artifactId>
            <version>1.0</version>
            <scope>system</scope>
            <systemPath>${ide.home}/lib/intellij.platform.projectModel.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>com.jetbrains</groupId>
            <artifactId>intellij.platform.projectModel.impl</artifactId>
